# Linker pnpm : isolé (défaut).
#
# Le mode `hoisted` était historiquement requis pour Expo, dont le bundler
# Metro ne suivait pas les liens symboliques. Ce n'est plus le cas : Metro
# gère les symlinks nativement depuis React Native 0.76 / Expo SDK 52.
#
# Le mode isolé est conservé car, sur Windows, `hoisted` recopie l'intégralité
# de l'arbre de dépendances à plat — plusieurs minutes à chaque installation.
# Si Expo posait malgré tout problème, la bascule se fait en une ligne ici,
# suivie d'un `pnpm install --force`.

link-workspace-packages=true
prefer-workspace-packages=true
strict-peer-dependencies=false
auto-install-peers=true

# Un changement de configuration de linker impose à pnpm de reconstruire
# node_modules. Sans ce réglage, il demande confirmation et échoue dans tout
# contexte non interactif (CI, scripts, agents).
confirm-modules-purge=false

# Expo et React Native résolvent certains paquets par remontée d'arborescence.
public-hoist-pattern[]=*expo*
public-hoist-pattern[]=*react-native*
public-hoist-pattern[]=@babel/*
