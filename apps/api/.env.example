# =============================================================================
# CSB Noutcha KAMGUE API — variables d'environnement
#
# Copiez ce fichier en .env :   cp .env.example .env
#
# L'API REFUSE de démarrer si une variable requise est absente ou mal typée
# (validation Zod dans src/platform/config.ts). C'est volontaire : mieux vaut
# un échec au démarrage qu'une panne à la première requête.
#
# Ports décalés pour cohabiter avec d'autres projets Docker sur la machine.
# Voir infra/docker/docker-compose.yml
# =============================================================================

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=debug

# --- Base de données ---------------------------------------------------------
# DATABASE_URL          : rôle applicatif (runtime). Privilèges restreints.
# DATABASE_MIGRATION_URL: rôle propriétaire. UNIQUEMENT pour prisma migrate.
DATABASE_URL="postgresql://cplan_app:cplan_dev_password@localhost:5442/cplan?schema=public"
DATABASE_MIGRATION_URL="postgresql://cplan:cplan_dev_password@localhost:5442/cplan?schema=public"

# --- Redis (files BullMQ, cache, rate limiting) ------------------------------
REDIS_URL="redis://localhost:6389"

# --- Stockage objet S3 (MinIO en local) --------------------------------------
S3_ENDPOINT="http://localhost:9010"
S3_REGION="us-east-1"
S3_BUCKET="cplan-dev"
S3_ACCESS_KEY_ID="cplan"
S3_SECRET_ACCESS_KEY="cplan_dev_password"
S3_FORCE_PATH_STYLE=true

# --- Sécurité ----------------------------------------------------------------
# En production : générer avec `openssl rand -base64 48`. JAMAIS ces valeurs.
JWT_SECRET="dev-only-secret-change-me-in-production-min-32-chars"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=30
JWT_REFRESH_TTL_DAYS_WEB=1

# --- CORS --------------------------------------------------------------------
CORS_ORIGINS="http://localhost:5173,http://localhost:8081"

# --- Application -------------------------------------------------------------
DEFAULT_TIMEZONE="Africa/Douala"
DEFAULT_COUNTRY_CODE="CM"
DEFAULT_CURRENCY="XAF"

# --- SMTP (Mailpit en local, UI sur http://localhost:8035) -------------------
SMTP_HOST="localhost"
SMTP_PORT=1035
SMTP_SECURE=false
SMTP_FROM="CSB Noutcha KAMGUE <no-reply@csb-noutcha-kamgue.local>"

# --- Mobile Money (Phase 11) -------------------------------------------------
PAYMENT_PROVIDER_MODE=fake
FAKE_PAYMENT_WEBHOOK_SECRET="cplan-fake-webhook-secret"
PAYMENT_WEBHOOK_BASE_URL="http://localhost:3000/api/v1/webhooks"
MTN_MOMO_BASE_URL="https://sandbox.momodeveloper.mtn.com"
MTN_MOMO_SUBSCRIPTION_KEY=""
MTN_MOMO_API_USER=""
MTN_MOMO_API_KEY=""
MTN_MOMO_TARGET_ENVIRONMENT="sandbox"
ORANGE_MONEY_BASE_URL=""
ORANGE_MONEY_TOKEN_URL="https://api.orange.com/oauth/v3/token"
ORANGE_MONEY_CLIENT_ID=""
ORANGE_MONEY_CLIENT_SECRET=""
ORANGE_MONEY_MERCHANT_KEY=""
