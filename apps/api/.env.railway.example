# Modèle Railway — ne jamais commiter les valeurs réelles.
# Les noms Postgres, Redis et Storage correspondent aux services Railway ;
# adaptez-les si vous leur donnez un autre nom dans le dashboard.

NODE_ENV=production
HOST=0.0.0.0
LOG_LEVEL=info

# Deux comptes PostgreSQL, OBLIGATOIREMENT distincts :
#   · DATABASE_MIGRATION_URL : compte propriétaire fourni par Railway, utilisé
#     uniquement par les migrations (pré-déploiement) ;
#   · DATABASE_URL : rôle restreint cplan_app, créé une fois avec
#     infra/railway/create-runtime-role.sql. Le compte `postgres` contourne la
#     RLS ; l'API refuse de démarrer en production s'il est utilisé.
# CPLAN_APP_DB_PASSWORD est une variable partagée (Project Settings > Shared
# Variables), égale au mot de passe passé au script.
DATABASE_URL=postgresql://cplan_app:${{shared.CPLAN_APP_DB_PASSWORD}}@${{Postgres.PGHOST}}:${{Postgres.PGPORT}}/${{Postgres.PGDATABASE}}
DATABASE_MIGRATION_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}

S3_ENDPOINT=${{Storage.ENDPOINT}}
S3_REGION=${{Storage.REGION}}
S3_BUCKET=${{Storage.BUCKET}}
S3_ACCESS_KEY_ID=${{Storage.ACCESS_KEY_ID}}
S3_SECRET_ACCESS_KEY=${{Storage.SECRET_ACCESS_KEY}}
S3_FORCE_PATH_STYLE=false

JWT_SECRET=GENERER_UN_SECRET_ALEATOIRE_DE_48_OCTETS_MINIMUM
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
JWT_REFRESH_TTL_DAYS_WEB=1

CORS_ORIGINS=https://VOTRE-PROJET.vercel.app,https://VOTRE-DOMAINE.cm
DEFAULT_TIMEZONE=Africa/Douala
DEFAULT_COUNTRY_CODE=CM
DEFAULT_CURRENCY=XAF

SMTP_HOST=VOTRE_SERVEUR_SMTP
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM="CSB Noutcha KAMGUE <no-reply@votre-domaine.cm>"

# La production refuse volontairement le fournisseur factice.
PAYMENT_PROVIDER_MODE=live
PAYMENT_WEBHOOK_BASE_URL=https://VOTRE-API.up.railway.app/api/v1/webhooks
FAKE_PAYMENT_WEBHOOK_SECRET=GENERER_UN_SECRET_WEBHOOK_DISTINCT

# Garde-fou : ne passez à true que temporairement sur une démo/staging.
ALLOW_DEMO_SEED=false

# Bootstrap production — à supprimer du service après la première exécution.
BOOTSTRAP_SCHOOL_CODE=ETABLISSEMENT
BOOTSTRAP_SCHOOL_NAME=Nom de votre établissement
BOOTSTRAP_ADMIN_FIRST_NAME=Prénom
BOOTSTRAP_ADMIN_LAST_NAME=Nom
BOOTSTRAP_ADMIN_EMAIL=admin@votre-domaine.cm
BOOTSTRAP_ADMIN_PHONE=+2376XXXXXXXX
BOOTSTRAP_ADMIN_PASSWORD=GENERER_UN_MOT_DE_PASSE_FORT_DE_16_CARACTERES_MINIMUM

# Décommenter avec les valeurs exactes fournies par les opérateurs.
# MTN_MOMO_BASE_URL=https://URL_FOURNIE_PAR_MTN
# MTN_MOMO_SUBSCRIPTION_KEY=...
# MTN_MOMO_API_USER=...
# MTN_MOMO_API_KEY=...
# MTN_MOMO_TARGET_ENVIRONMENT=production

# ORANGE_MONEY_BASE_URL=https://URL_FOURNIE_PAR_ORANGE
# ORANGE_MONEY_TOKEN_URL=https://api.orange.com/oauth/v3/token
# ORANGE_MONEY_CLIENT_ID=...
# ORANGE_MONEY_CLIENT_SECRET=...
# ORANGE_MONEY_MERCHANT_KEY=...
