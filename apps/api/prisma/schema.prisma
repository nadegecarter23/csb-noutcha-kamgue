// =============================================================================
// CSB Noutcha KAMGUE — schéma Prisma
//
// Le modèle complet est décrit dans docs/03-MODELE-DONNEES.md.
// Les tables sont introduites phase par phase :
//
//   Phase 01 → identité, rôles, accès, socle transverse          ✓ (ce fichier)
//   Phase 02 → academic_years, grade_levels, classes, student_categories ✓
//   Phase 03 → students, enrollments, student_class_changes             ✓
//   Phase 04 → guardians, student_guardians, guardian_invites, …        ✓
//   Phase 06 → fee_types, fee_structures, student_fee_assignments, discounts
//   Phase 07 → payments, payment_allocations, receipts, …
//
// Conventions (docs/06-CONVENTIONS-DEV.md §1) :
//   · tables au pluriel, snake_case  · colonnes snake_case
//   · PK uuid v7 générée en base     · timestamptz partout
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// A. Établissement & configuration
// =============================================================================

enum SchoolStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED

  @@map("school_status")
}

model School {
  id         String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name       String
  code       String       @unique
  address    String?
  phone      String?
  email      String?      @db.Citext
  logoFileId String?      @map("logo_file_id") @db.Uuid
  status     SchoolStatus @default(ACTIVE)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  settings                   SchoolSettings?
  moduleSettings             SchoolModuleSetting[]
  organizationalUnits        OrganizationalUnit[]
  languageSections           LanguageSection[]
  educationTracks            EducationTrack[]
  staffAssignments           StaffAssignment[]
  userAccessScopes           UserAccessScope[]
  staffProfiles              StaffProfile[]
  staffDepartments           StaffDepartment[]
  staffPositions             StaffPosition[]
  staffLeaves                StaffLeave[]
  announcements              Announcement[]
  schoolEvents               SchoolEvent[]
  homework                   Homework[]
  schoolMessages             SchoolMessage[]
  libraryBooks               LibraryBook[]
  libraryLoans               LibraryLoan[]
  canteenMeals               CanteenMeal[]
  transportRoutes            TransportRoute[]
  transportEnrollments       TransportEnrollment[]
  inventoryItems             InventoryItem[]
  inventoryMovements         InventoryMovement[]
  suppliers                  Supplier[]
  expenseCategories          ExpenseCategory[]
  purchaseOrders             PurchaseOrder[]
  purchaseOrderLines         PurchaseOrderLine[]
  expenses                   Expense[]
  supplierPayments           SupplierPayment[]
  userRoles                  UserRole[]
  roles                      Role[]
  files                      File[]
  auditLogs                  AuditLog[]
  sequences                  NumberSequence[]
  academicYears              AcademicYear[]
  gradeLevels                GradeLevel[]
  classes                    Class[]
  studentCategories          StudentCategory[]
  students                   Student[]
  enrollments                Enrollment[]
  guardians                  Guardian[]
  guardianInvites            GuardianInvite[]
  guardianRequests           GuardianLinkRequest[]
  feeTypes                   FeeType[]
  feeStructures              FeeStructure[]
  feeAssignments             StudentFeeAssignment[]
  payments                   Payment[]
  paymentAllocations         PaymentAllocation[]
  paymentTargets             PaymentTarget[]
  receipts                   Receipt[]
  importBatches              ImportBatch[]
  cashSessions               CashSession[]
  cashRegisters              CashRegister[]
  budgets                    Budget[]
  cashMovements              CashSessionMovement[]
  notifications              Notification[]
  notificationTemplates      NotificationTemplate[]
  notificationDeliveries     NotificationDelivery[]
  externalDeclarations       ExternalPaymentDeclaration[]
  externalProofs             ExternalPaymentProof[]
  providerEvents             PaymentProviderEvent[]
  mobileMoneyReconciliations MobileMoneyReconciliation[]
  savedReportQueries         SavedReportQuery[]
  exportJobs                 ExportJob[]
  documentTemplate           DocumentTemplate?
  subjects                   Subject[]
  teachingAssignments        TeachingAssignment[]
  timetableRooms             TimetableRoom[]
  timetableEntries           TimetableEntry[]
  attendanceSessions         AttendanceSession[]
  attendanceRecords          AttendanceRecord[]
  academicPeriods            AcademicPeriod[]
  assessmentTypes            AssessmentType[]
  competencies               Competency[]
  gradingPolicies            GradingPolicy[]
  assessments                Assessment[]
  assessmentCompetencies     AssessmentCompetency[]
  grades                     Grade[]
  reportCards                ReportCard[]
  reportCardSubjects         ReportCardSubject[]
  studentIncidents           StudentIncident[]
  healthVisits               HealthVisit[]

  @@map("schools")
}

/// Paramétrage par établissement — évite de coder en dur ce qui doit pouvoir
/// changer sans déploiement (§16, §28, §79 du cahier).
model SchoolSettings {
  schoolId String @id @map("school_id") @db.Uuid
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  timezone String @default("Africa/Douala")
  currency String @default("XAF") @db.Char(3)

  // Numérotation — voir NumberSequence
  studentNumberPrefix  String @default("CPLAN-") @map("student_number_prefix")
  studentNumberPadding Int    @default(5) @map("student_number_padding")
  receiptNumberFormat  String @default("CPL-RCT-{YEAR}-{SEQ:6}") @map("receipt_number_format")
  paymentRefFormat     String @default("CPL-{YYMMDD}-{SEQ:6}") @map("payment_reference_format")

  // Règles financières (exploitées à partir de la Phase 06)
  allocationStrategy String  @default("BY_PRIORITY_THEN_DUE_DATE") @map("allocation_strategy")
  allowOverpayment   Boolean @default(true) @map("allow_overpayment")

  // Relances (Phase 13) et SLA de validation (§49)
  reminderDaysBefore      Int[]    @default([7, 1]) @map("reminder_days_before")
  reminderDaysAfter       Int[]    @default([7, 15, 30]) @map("reminder_days_after")
  externalPaymentSlaHours Int      @default(48) @map("external_payment_sla_hours")
  smsEnabled              Boolean  @default(false) @map("sms_enabled")
  smsAllowedTypes         String[] @default(["PAYMENT_CONFIRMED", "EXTERNAL_PAYMENT_REJECTED", "INSTALLMENT_OVERDUE"]) @map("sms_allowed_types")
  smsMonthlyLimit         BigInt   @default(50000) @map("sms_monthly_limit")
  notificationStartHour   Int      @default(8) @map("notification_start_hour")
  notificationEndHour     Int      @default(19) @map("notification_end_hour")
  balanceReminderEnabled  Boolean  @default(false) @map("balance_reminder_enabled")

  // Associations parent-élève (Phase 04)
  inviteTokenTtlDays Int @default(60) @map("invite_token_ttl_days")

  discountApprovalThreshold Int @default(0) @map("discount_approval_threshold")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("school_settings")
}

/// Activation fonctionnelle par établissement. L'absence d'une ligne signifie
/// « actif » afin de préserver le comportement des établissements existants.
model SchoolModuleSetting {
  schoolId   String   @map("school_id") @db.Uuid
  moduleCode String   @map("module_code") @db.VarChar(40)
  enabled    Boolean  @default(true)
  updatedBy  String?  @map("updated_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@id([schoolId, moduleCode])
  @@index([schoolId, enabled])
  @@map("school_module_settings")
}

enum SequenceScope {
  STUDENT_NUMBER
  RECEIPT
  PAYMENT_REF
  INVOICE
  PURCHASE_ORDER
  EXPENSE
  SUPPLIER_PAYMENT

  @@map("sequence_scope")
}

/// Séquences métier, allouées par verrou de ligne dans la transaction appelante.
///
/// Une SEQUENCE PostgreSQL ne revient pas en arrière sur un rollback : elle
/// laisserait des trous dans la numérotation des reçus, ce qui est inacceptable
/// pour une pièce comptable (ADR-019).
model NumberSequence {
  schoolId String        @map("school_id") @db.Uuid
  scope    SequenceScope
  /// '' pour une séquence continue, '2026' ou '202608' pour une séquence périodique.
  period   String        @default("")

  currentValue BigInt @default(0) @map("current_value")

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@id([schoolId, scope, period])
  @@map("number_sequences")
}

enum FileKind {
  STUDENT_PHOTO
  PAYMENT_PROOF
  RECEIPT_PDF
  IMPORT_FILE
  SCHOOL_LOGO
  EXPORT
  EXPENSE_DOCUMENT

  @@map("file_kind")
}

/// Aucune URL publique n'est stockée : l'accès passe par une URL pré-signée
/// à durée courte, générée après contrôle de permission (ADR-007).
model File {
  id       String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId String @map("school_id") @db.Uuid

  storageKey     String   @map("storage_key")
  originalName   String?  @map("original_name")
  mimeType       String   @map("mime_type")
  sizeBytes      BigInt   @map("size_bytes")
  checksumSha256 String?  @map("checksum_sha256")
  kind           FileKind

  uploadedBy String?  @map("uploaded_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  school                School                 @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  author                User?                  @relation("FileUploader", fields: [uploadedBy], references: [id], onDelete: SetNull)
  studentPhotos         Student[]              @relation("StudentPhoto")
  receiptPdfs           Receipt[]              @relation("ReceiptPdf")
  importBatches         ImportBatch[]
  externalPaymentProofs ExternalPaymentProof[]
  exportJobs            ExportJob[]
  expenseDocuments      Expense[]              @relation("ExpenseAttachment")

  @@unique([schoolId, storageKey])
  @@index([schoolId, kind, createdAt(sort: Desc)])
  @@map("files")
}

// =============================================================================
// B. Identité, rôles & accès
// =============================================================================

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DISABLED

  @@map("user_status")
}

/// Un utilisateur n'appartient PAS à un établissement.
///
/// Un parent peut avoir des enfants dans plusieurs écoles ; le rattachement
/// passe par UserRole et StaffProfile (docs/03 §B).
model User {
  id        String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  firstName String @map("first_name")
  lastName  String @map("last_name")

  /// Format E.164 strict — clé de la détection automatique des enfants (§8).
  /// La normalisation est assurée par @cplan/domain, sans exception.
  phone           String    @unique
  phoneVerifiedAt DateTime? @map("phone_verified_at") @db.Timestamptz(3)

  email           String?   @unique @db.Citext
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)

  /// Argon2id. Null tant que le compte est créé par invitation.
  passwordHash String? @map("password_hash")
  /// Vrai pour un secret initial remis par l'administration ou le bootstrap.
  mustChangePassword Boolean @default(false) @map("must_change_password")

  status      UserStatus @default(PENDING_VERIFICATION)
  lastLoginAt DateTime?  @map("last_login_at") @db.Timestamptz(3)

  /// Verrouillage progressif après échecs de connexion.
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  staffProfiles               StaffProfile[]
  studentProfiles             Student[]                    @relation("StudentPortalUser")
  userRoles                   UserRole[]
  sessions                    Session[]
  auditLogs                   AuditLog[]
  uploadedFiles               File[]                       @relation("FileUploader")
  idempotencyKeys             IdempotencyKey[]
  headedClasses               Class[]                      @relation("ClassHeadTeacher")
  guardianProfiles            Guardian[]
  classChanges                StudentClassChange[]         @relation("ClassChangeActor")
  createdStudentGuardianLinks StudentGuardian[]            @relation("StudentGuardianCreator")
  revokedStudentGuardianLinks StudentGuardian[]            @relation("StudentGuardianRevoker")
  createdGuardianInvites      GuardianInvite[]             @relation("GuardianInviteCreator")
  guardianInviteUses          GuardianInviteUse[]
  requestedGuardianLinks      GuardianLinkRequest[]        @relation("GuardianRequestAuthor")
  handledGuardianLinks        GuardianLinkRequest[]        @relation("GuardianRequestHandler")
  createdDiscounts            Discount[]                   @relation("DiscountCreator")
  approvedDiscounts           Discount[]                   @relation("DiscountApprover")
  createdPayments             Payment[]                    @relation("PaymentCreator")
  validatedPayments           Payment[]                    @relation("PaymentValidator")
  payerPayments               Payment[]                    @relation("PaymentPayer")
  createdAllocations          PaymentAllocation[]          @relation("AllocationCreator")
  issuedReceipts              Receipt[]                    @relation("ReceiptIssuer")
  createdImports              ImportBatch[]
  cashSessions                CashSession[]                @relation("CashSessionCashier")
  reconciledCashSessions      CashSession[]                @relation("CashSessionReconciler")
  cashMovements               CashSessionMovement[]
  devices                     Device[]
  notifications               Notification[]
  notificationPreference      NotificationPreference?
  declaredExternalPayments    ExternalPaymentDeclaration[] @relation("ExternalPaymentDeclarer")
  decidedExternalPayments     ExternalPaymentDeclaration[] @relation("ExternalPaymentDecider")
  savedReportQueries          SavedReportQuery[]
  exportJobs                  ExportJob[]
  teachingAssignments         TeachingAssignment[]         @relation("TeachingAssignmentTeacher")
  accessScopes                UserAccessScope[]             @relation("AccessScopeUser")
  grantedAccessScopes         UserAccessScope[]             @relation("AccessScopeGrantor")
  recordedAttendanceSessions  AttendanceSession[]           @relation("AttendanceRecorder")
  validatedAttendanceSessions AttendanceSession[]           @relation("AttendanceValidator")

  @@index([status])
  @@map("users")
}

enum StaffStatus {
  ACTIVE
  SUSPENDED
  ON_LEAVE
  LEFT

  @@map("staff_status")
}

enum EmploymentType {
  PERMANENT
  FIXED_TERM
  VACATION
  INTERN

  @@map("employment_type")
}

enum StaffLeaveStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("staff_leave_status")
}

model StaffProfile {
  id       String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId   String @map("user_id") @db.Uuid
  schoolId String @map("school_id") @db.Uuid

  employeeNumber String?     @map("employee_number")
  jobTitle       String?     @map("job_title")
  employmentType EmploymentType? @map("employment_type")
  hiredAt        DateTime?   @map("hired_at") @db.Date
  contractEnd    DateTime?   @map("contract_end") @db.Date
  weeklyWorkload Int         @default(0) @map("weekly_workload")
  status         StaffStatus @default(ACTIVE)
  departmentId  String?      @map("department_id") @db.Uuid
  positionId    String?      @map("position_id") @db.Uuid
  supervisorId  String?      @map("supervisor_id") @db.Uuid
  isStaffDelegate Boolean    @default(false) @map("is_staff_delegate")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  leaves StaffLeave[]
  assignments StaffAssignment[]
  department StaffDepartment? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  position StaffPosition? @relation(fields: [positionId], references: [id], onDelete: SetNull)
  supervisor StaffProfile? @relation("StaffHierarchy", fields: [supervisorId], references: [id], onDelete: SetNull)
  reports StaffProfile[] @relation("StaffHierarchy")

  @@unique([userId, schoolId])
  @@unique([schoolId, employeeNumber])
  @@index([schoolId, departmentId, positionId, status])
  @@index([supervisorId])
  @@map("staff_profiles")
}

model StaffDepartment {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId String @map("school_id") @db.Uuid
  organizationalUnitId String? @map("organizational_unit_id") @db.Uuid
  code String
  name String
  status ReferenceStatus @default(ACTIVE)
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  organizationalUnit OrganizationalUnit? @relation(fields: [organizationalUnitId], references: [id], onDelete: Restrict)
  positions StaffPosition[]
  staff StaffProfile[]
  @@unique([schoolId, code])
  @@index([schoolId, organizationalUnitId, status])
  @@map("staff_departments")
}

model StaffPosition {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId String @map("school_id") @db.Uuid
  departmentId String? @map("department_id") @db.Uuid
  code String
  name String
  rank Int @default(100)
  isManagement Boolean @default(false) @map("is_management")
  status ReferenceStatus @default(ACTIVE)
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  department StaffDepartment? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  staff StaffProfile[]
  @@unique([schoolId, code])
  @@index([schoolId, departmentId, status, rank])
  @@map("staff_positions")
}

model StaffLeave {
  id             String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId       String           @map("school_id") @db.Uuid
  staffProfileId String           @map("staff_profile_id") @db.Uuid
  type           String
  startsAt       DateTime         @map("starts_at") @db.Date
  endsAt         DateTime         @map("ends_at") @db.Date
  reason         String
  status         StaffLeaveStatus @default(PENDING)
  decidedAt      DateTime?        @map("decided_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  school School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staff  StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)

  @@index([schoolId, status, startsAt])
  @@index([staffProfileId, startsAt])
  @@map("staff_leaves")
}

enum CommunicationAudience {
  ALL
  STAFF
  FAMILIES
  STUDENTS

  @@map("communication_audience")
}

model Announcement {
  id              String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId        String                @map("school_id") @db.Uuid
  title           String
  body            String
  audience        CommunicationAudience @default(ALL)
  publishedAt     DateTime              @default(now()) @map("published_at") @db.Timestamptz(3)
  expiresAt       DateTime?             @map("expires_at") @db.Timestamptz(3)
  createdByUserId String                @map("created_by_user_id") @db.Uuid
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  school          School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  @@index([schoolId, publishedAt])
  @@map("announcements")
}

model SchoolEvent {
  id          String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId    String                @map("school_id") @db.Uuid
  title       String
  description String?
  location    String?
  audience    CommunicationAudience @default(ALL)
  startsAt    DateTime              @map("starts_at") @db.Timestamptz(3)
  endsAt      DateTime              @map("ends_at") @db.Timestamptz(3)
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  school      School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  @@index([schoolId, startsAt])
  @@map("school_events")
}

enum HomeworkStatus {
  DRAFT
  PUBLISHED

  @@map("homework_status")
}

model Homework {
  id             String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId       String         @map("school_id") @db.Uuid
  academicYearId String         @map("academic_year_id") @db.Uuid
  classId        String         @map("class_id") @db.Uuid
  subjectId      String         @map("subject_id") @db.Uuid
  title          String
  instructions   String
  dueAt          DateTime       @map("due_at") @db.Timestamptz(3)
  status         HomeworkStatus @default(DRAFT)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  school         School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  class          Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject        Subject        @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  @@index([schoolId, academicYearId, dueAt])
  @@map("homework")
}

model SchoolMessage {
  id              String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId        String    @map("school_id") @db.Uuid
  senderUserId    String    @map("sender_user_id") @db.Uuid
  recipientUserId String    @map("recipient_user_id") @db.Uuid
  subject         String
  body            String
  sentAt          DateTime  @default(now()) @map("sent_at") @db.Timestamptz(3)
  readAt          DateTime? @map("read_at") @db.Timestamptz(3)
  school          School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  @@index([schoolId, recipientUserId, sentAt])
  @@index([schoolId, senderUserId, sentAt])
  @@map("school_messages")
}

model LibraryBook {
  id        String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId  String        @map("school_id") @db.Uuid
  isbn      String?
  title     String
  author    String
  stock     Int
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  school    School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  loans     LibraryLoan[]
  @@unique([schoolId, isbn])
  @@map("library_books")
}

model LibraryLoan {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId     String    @map("school_id") @db.Uuid
  bookId       String    @map("book_id") @db.Uuid
  enrollmentId String    @map("enrollment_id") @db.Uuid
  borrowedAt   DateTime  @default(now()) @map("borrowed_at") @db.Date
  dueAt        DateTime  @map("due_at") @db.Date
  returnedAt   DateTime? @map("returned_at") @db.Date
  school       School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  book         LibraryBook @relation(fields: [bookId], references: [id], onDelete: Restrict)
  @@index([schoolId, enrollmentId, dueAt])
  @@map("library_loans")
}

model CanteenMeal {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  date      DateTime @db.Date
  menu      String
  planned   Int
  served    Int
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  @@unique([schoolId, date])
  @@map("canteen_meals")
}

model TransportRoute {
  id        String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId  String          @map("school_id") @db.Uuid
  name      String
  vehicle   String
  driver    String
  capacity  Int
  enrolled  Int             @default(0)
  stops     Json
  status    ReferenceStatus @default(ACTIVE)
  feeStructureId String?    @map("fee_structure_id") @db.Uuid
  school    School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  feeStructure FeeStructure? @relation(fields: [feeStructureId], references: [id], onDelete: SetNull)
  enrollments TransportEnrollment[]
  @@unique([schoolId, name])
  @@map("transport_routes")
}

model TransportEnrollment {
  id                     String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId               String                @map("school_id") @db.Uuid
  routeId                String                @map("route_id") @db.Uuid
  enrollmentId           String                @map("enrollment_id") @db.Uuid
  studentFeeAssignmentId String?               @unique @map("student_fee_assignment_id") @db.Uuid
  createdAt              DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  school                 School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  route                  TransportRoute        @relation(fields: [routeId], references: [id], onDelete: Cascade)
  enrollment             Enrollment            @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
