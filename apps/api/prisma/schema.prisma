/// Un rôle est un REGROUPEMENT DE PERMISSIONS, jamais une valeur testée dans
/// le code. On n'écrit pas `if (role === 'ACCOUNTANT')` mais
/// `requirePermission('payments.validate_external')` (docs/05 §1).
model Role {
  id          String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code        String
  name        String
  description String?

  /// Les 8 rôles du §55 sont système : ni supprimables, ni renommables.
  isSystem Boolean @default(false) @map("is_system")

  /// NULL = rôle global de la plateforme ; renseigné = rôle propre à une école.
  schoolId String? @map("school_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  school      School?          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  userRoles   UserRole[]

  @@unique([code, schoolId])
  @@map("roles")
}

/// Catalogue figé, chargé par migration de seed. Aucune création dynamique.
model Permission {
  id          String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code        String @unique
  description String
  /// Domaine fonctionnel, pour le regroupement dans l'interface.
  group       String

  roles RolePermission[]

  @@index([group])
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Un utilisateur peut être comptable dans l'école A et parent dans l'école B.
///
/// `schoolId` étant nullable (rôles de plateforme), il ne peut pas entrer dans
/// une clé primaire. L'unicité de (user, rôle, école) est garantie par un index
/// `UNIQUE NULLS NOT DISTINCT` posé en SQL brut dans la migration : sans cette
/// clause, PostgreSQL considère deux NULL comme distincts et laisserait créer
/// des doublons de rôles de plateforme.
model UserRole {
  id       String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId   String  @map("user_id") @db.Uuid
  roleId   String  @map("role_id") @db.Uuid
  /// NULL pour un rôle de plateforme (SUPER_ADMIN) ou pour PARENT.
  schoolId String? @map("school_id") @db.Uuid

  grantedBy String?  @map("granted_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  school School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, schoolId])
  @@index([userId])
  @@index([schoolId])
  @@map("user_roles")
}

/// Refresh tokens, stockés hachés, avec rotation et détection de réutilisation.
///
/// Présenter un refresh token déjà consommé révoque TOUTE la famille : c'est le
/// signe d'un vol de jeton (ADR-010).
model Session {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  userId           String @map("user_id") @db.Uuid
  refreshTokenHash String @unique @map("refresh_token_hash")
  familyId         String @map("family_id") @db.Uuid

  deviceLabel String? @map("device_label")
  ipAddress   String? @map("ip_address") @db.Inet
  userAgent   String? @map("user_agent")

  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("sessions")
}

