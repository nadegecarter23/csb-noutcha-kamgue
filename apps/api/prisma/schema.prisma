  requestedByUserId    String                @map("requested_by_user_id") @db.Uuid
  studentId            String?               @map("student_id") @db.Uuid
  claimedStudentNumber String?               @map("claimed_student_number")
  claimedStudentName   String?               @map("claimed_student_name")
  relationship         GuardianRelationship?
  kind                 GuardianRequestKind
  message              String?
  status               GuardianRequestStatus @default(PENDING)
  handledBy            String?               @map("handled_by") @db.Uuid
  handledAt            DateTime?             @map("handled_at") @db.Timestamptz(3)
  resolutionNote       String?               @map("resolution_note")
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  school    School   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  requester User     @relation("GuardianRequestAuthor", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  student   Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  handler   User?    @relation("GuardianRequestHandler", fields: [handledBy], references: [id], onDelete: SetNull)

  @@index([schoolId, status, kind, createdAt(sort: Desc)])
  @@index([requestedByUserId, status])
  @@index([studentId])
  @@map("guardian_link_requests")
}

