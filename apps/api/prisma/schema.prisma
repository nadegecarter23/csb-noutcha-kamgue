}

model Notification {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  schoolId   String?   @map("school_id") @db.Uuid
  type       String
  title      String
  body       String
  data       Json      @default("{}")
  dedupKey   String?   @map("dedup_key")
  isCritical Boolean   @default(false) @map("is_critical")
  readAt     DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  school     School?                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@unique([userId, dedupKey])
  @@index([userId, readAt, createdAt(sort: Desc)])
  @@index([schoolId, createdAt(sort: Desc)])
  @@map("notifications")
}

enum NotificationChannel {
  IN_APP
  PUSH
  SMS
  EMAIL

  @@map("notification_channel")
}

enum NotificationDeliveryStatus {
  PENDING
  SENDING
  DELIVERED
  FAILED
  DEAD_LETTER
  SKIPPED

  @@map("notification_delivery_status")
}

model NotificationDelivery {
  id                String                     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  notificationId    String                     @map("notification_id") @db.Uuid
  schoolId          String?                    @map("school_id") @db.Uuid
  channel           NotificationChannel
  status            NotificationDeliveryStatus @default(PENDING)
  attempts          Int                        @default(0)
  maxAttempts       Int                        @default(3) @map("max_attempts")
  providerMessageId String?                    @map("provider_message_id")
  error             String?
  cost              BigInt                     @default(0)
  nextAttemptAt     DateTime                   @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  sentAt            DateTime?                  @map("sent_at") @db.Timestamptz(3)
  deliveredAt       DateTime?                  @map("delivered_at") @db.Timestamptz(3)
  createdAt         DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  notification      Notification               @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  school            School?                    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@index([status, nextAttemptAt])
  @@index([schoolId, channel, createdAt])
  @@map("notification_deliveries")
}

model NotificationPreference {
  userId          String   @id @map("user_id") @db.Uuid
  pushEnabled     Boolean  @default(true) @map("push_enabled")
  smsEnabled      Boolean  @default(true) @map("sms_enabled")
  emailEnabled    Boolean  @default(true) @map("email_enabled")
  paymentEnabled  Boolean  @default(true) @map("payment_enabled")
  reminderEnabled Boolean  @default(true) @map("reminder_enabled")
  newsEnabled     Boolean  @default(false) @map("news_enabled")
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model NotificationTemplate {
  id        String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId  String              @map("school_id") @db.Uuid
  type      String
  channel   NotificationChannel
  title     String?
  body      String
  isActive  Boolean             @default(true) @map("is_active")
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  school    School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, type, channel])
  @@index([schoolId, type])
  @@map("notification_templates")
}

enum ActorType {
  USER
  SYSTEM
  WEBHOOK

  @@map("actor_type")
}

/// Table APPEND-ONLY : les privilèges UPDATE et DELETE sont retirés au rôle
/// applicatif par migration (règle 10 du §81).
model AuditLog {
  id       String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId String? @map("school_id") @db.Uuid

  userId    String?   @map("user_id") @db.Uuid
  actorType ActorType @default(USER) @map("actor_type")

  action     String
  entityType String @map("entity_type")
  entityId   String @map("entity_id")

  /// Uniquement les champs modifiés, secrets exclus par liste noire.
  oldValues Json? @map("old_values")
  newValues Json? @map("new_values")
  /// Montant, motif, référence — un journal lisible sans jointure.
  metadata  Json?

  ipAddress String?  @map("ip_address") @db.Inet
  userAgent String?  @map("user_agent")
  requestId String?  @map("request_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  school School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([schoolId, createdAt(sort: Desc)])
  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@map("audit_logs")
}
