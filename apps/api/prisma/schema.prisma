}

enum ImportBatchStatus {
  UPLOADED
  MAPPED
  VALIDATED
  IMPORTING
  COMPLETED
  FAILED

  @@map("import_batch_status")
}

enum ImportRowStatus {
  PENDING
  VALID
  ERROR
  IMPORTED
  SKIPPED

  @@map("import_row_status")
}

model ImportBatch {
  id             String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId       String            @map("school_id") @db.Uuid
  fileId         String?           @map("file_id") @db.Uuid
  type           ImportBatchType   @default(STUDENTS)
  academicYearId String?           @map("academic_year_id") @db.Uuid
  columnMapping  Json              @default("{}") @map("column_mapping")
  status         ImportBatchStatus @default(UPLOADED)
  totalRows      Int               @default(0) @map("total_rows")
  validRows      Int               @default(0) @map("valid_rows")
  errorRows      Int               @default(0) @map("error_rows")
  importedRows   Int               @default(0) @map("imported_rows")
  createdBy      String?           @map("created_by") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  school         School            @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  file           File?             @relation(fields: [fileId], references: [id], onDelete: SetNull)
  academicYear   AcademicYear?     @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  creator        User?             @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  rows           ImportRow[]

  @@index([schoolId, status, createdAt(sort: Desc)])
  @@index([fileId])
  @@index([academicYearId])
  @@index([createdBy])
  @@map("import_batches")
}

model ImportRow {
  id              String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
