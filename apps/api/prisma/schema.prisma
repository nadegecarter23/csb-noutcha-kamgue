}

/// Entité permanente. La classe et l'année appartiennent exclusivement à Enrollment.
model Student {
  id            String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId      String        @map("school_id") @db.Uuid
  studentNumber String        @map("student_number")
  firstName     String        @map("first_name")
  lastName      String        @map("last_name")
  dateOfBirth   DateTime?     @map("date_of_birth") @db.Date
  placeOfBirth  String?       @map("place_of_birth")
  gender        Gender?
  photoFileId   String?       @map("photo_file_id") @db.Uuid
  portalUserId  String?       @unique @map("portal_user_id") @db.Uuid
  status        StudentStatus @default(ACTIVE)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  school               School                       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  photo                File?                        @relation("StudentPhoto", fields: [photoFileId], references: [id], onDelete: SetNull)
  portalUser           User?                        @relation("StudentPortalUser", fields: [portalUserId], references: [id], onDelete: SetNull)
  enrollments          Enrollment[]
  guardianLinks        StudentGuardian[]
  invites              GuardianInvite[]
  guardianRequests     GuardianLinkRequest[]
  feeAssignments       StudentFeeAssignment[]
  paymentAllocations   PaymentAllocation[]
  paymentTargets       PaymentTarget[]
  externalDeclarations ExternalPaymentDeclaration[]

  @@unique([schoolId, studentNumber])
  @@index([schoolId, status])
  @@index([schoolId, lastName, firstName])
  @@map("students")
}

model Enrollment {
  id                String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  studentId         String           @map("student_id") @db.Uuid
  schoolId          String           @map("school_id") @db.Uuid
  academicYearId    String           @map("academic_year_id") @db.Uuid
  classId           String?          @map("class_id") @db.Uuid
  studentCategoryId String?          @map("student_category_id") @db.Uuid
  enrollmentDate    DateTime         @map("enrollment_date") @db.Date
  enrollmentType    EnrollmentType   @default(NEW) @map("enrollment_type")
  status            EnrollmentStatus @default(ACTIVE)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  student              Student                      @relation(fields: [studentId], references: [id], onDelete: Restrict)
  school               School                       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicYear         AcademicYear                 @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  class                Class?                       @relation(fields: [classId], references: [id], onDelete: Restrict)
  studentCategory      StudentCategory?             @relation(fields: [studentCategoryId], references: [id], onDelete: Restrict)
  classChanges         StudentClassChange[]
  attendanceRecords    AttendanceRecord[]
  grades               Grade[]
  reportCards          ReportCard[]
  studentIncidents     StudentIncident[]
  healthVisits         HealthVisit[]
  transportEnrollments TransportEnrollment[]
  feeAssignments       StudentFeeAssignment[]
  paymentAllocations   PaymentAllocation[]
  paymentTargets       PaymentTarget[]
  externalDeclarations ExternalPaymentDeclaration[]

  @@unique([studentId, academicYearId])
  @@index([schoolId, academicYearId, status])
  @@index([classId, status])
  @@index([studentCategoryId])
  @@map("enrollments")
}

model StudentClassChange {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  enrollmentId String   @map("enrollment_id") @db.Uuid
  fromClassId  String?  @map("from_class_id") @db.Uuid
  toClassId    String?  @map("to_class_id") @db.Uuid
  reason       String
  effectiveAt  DateTime @default(now()) @map("effective_at") @db.Timestamptz(3)
  changedBy    String?  @map("changed_by") @db.Uuid
  changedAt    DateTime @default(now()) @map("changed_at") @db.Timestamptz(3)

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  fromClass  Class?     @relation("ClassChangeFrom", fields: [fromClassId], references: [id], onDelete: SetNull)
  toClass    Class?     @relation("ClassChangeTo", fields: [toClassId], references: [id], onDelete: SetNull)
  actor      User?      @relation("ClassChangeActor", fields: [changedBy], references: [id], onDelete: SetNull)

  @@index([enrollmentId, changedAt(sort: Desc)])
  @@index([fromClassId])
  @@index([toClassId])
  @@map("student_class_changes")
}

