# URL publique de l'API, avec le préfixe de version et sans slash final.
# En local, cette variable peut être omise : Vite utilise alors /api/v1
# et son proxy vers http://localhost:3000.
VITE_API_BASE_URL="https://VOTRE-API.up.railway.app/api/v1"

# Toujours false sur Vercel en production. Le mode démo hors-ligne est réservé
# au développement local ou à un environnement de démonstration explicite.
VITE_ENABLE_DEMO_MODE=false
